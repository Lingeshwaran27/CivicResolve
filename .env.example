# ──────────────────────────────────────────────────────────────
# CivicResolve configuration. Copy to `.env` and fill in values.
# NEVER commit your real .env — it is gitignored.
# ──────────────────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development
# Comma-separated list of origins allowed to call the API in dev (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# ── Google Gemini (primary AI) ── free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned model (fast + multimodal). Alternatives: gemini-2.5-flash-lite (higher free quota), gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Reasoning depth: minimal|low|medium|high (mapped to thinking budget/level per model family)
GEMINI_THINKING=minimal
# Self-imposed budget so the free tier is never exhausted (keep below your AI Studio limits)
GEMINI_RPM=8
GEMINI_RPD=200

# ── OpenRouter (fallback AI, optional) ── https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model with the ":free" suffix, see https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_RPM=10
OPENROUTER_RPD=45

# ── Admin console ──
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-at-least-32-random-characters

# ── Firestore (optional; in-memory store with demo data is used if unset) ──
# On Google Cloud Run: set FIRESTORE_ENABLED=true and grant the service account "Cloud Datastore User".
# Elsewhere (Render, local): also set FIREBASE_SERVICE_ACCOUNT_B64 = base64 of the service-account JSON.
FIRESTORE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Seed the in-memory store with realistic sample issues (ignored when Firestore is enabled)
SEED_DEMO_DATA=true
