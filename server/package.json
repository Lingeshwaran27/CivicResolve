{
  "name": "@civicresolve/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "firebase-admin": "14.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
